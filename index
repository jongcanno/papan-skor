    // -------------------------------------------------------------------------
    // TIMER COUNTDOWN ENGINE
    // -------------------------------------------------------------------------
    setInterval(() => {
      if (!state.timerRunning) return;
      if (state.timerSeconds > 0) {
        state.timerSeconds -= 1;
        renderTimerOnly();
        if (state.timerSeconds === 0) {
          state.timerRunning = false;
          renderAll();
          triggerOverlay({ type: 'TIMEUP' });
        }
      }
    }, 1000);

    function formatMMSS(totalSec) {
      const m = Math.floor(totalSec / 60);
      const s = totalSec % 60;
      return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
    }

    function renderTimerOnly() {
      const formatted = formatMMSS(state.timerSeconds);
      const timerEl = document.getElementById('display-timer');
      const remoteTimerEl = document.getElementById('remote-timer-preview');
      if (timerEl) {
        timerEl.textContent = formatted;
        if (state.timerSeconds <= 60) {
          timerEl.className = 'text-[128px] leading-none font-bold tracking-wider neon-timer-danger my-2';
        } else {
          timerEl.className = 'text-[128px] leading-none font-bold tracking-wider neon-timer my-2';
        }
      }
      if (remoteTimerEl) remoteTimerEl.textContent = formatted;
    }

    // -------------------------------------------------------------------------
    // UI RENDERING FUNCTIONS
    // -------------------------------------------------------------------------
    function renderPenaltyDots(teamKey, containerId, scoreId) {
      const container = document.getElementById(containerId);
      const scoreEl = document.getElementById(scoreId);
      if (!container) return;
      const arr = state[teamKey].penalties;
      const goals = arr.filter((x) => x === 'goal').length;
      const taken = arr.filter((x) => x !== null).length;
      if (scoreEl) scoreEl.textContent = `${goals} / ${taken}`;

      container.innerHTML = arr
        .map((status, idx) => {
          let cls = 'bg-slate-900/90 border-white/20 text-slate-500';
          let label = idx + 1;
          if (status === 'goal') {
            cls = 'pen-dot-goal text-slate-950 font-black';
            label = '✓';
          } else if (status === 'miss') {
            cls = 'pen-dot-miss text-white font-black';
            label = '✕';
          }
          return `
            <button data-team="${teamKey}" data-idx="${idx}"
              title="Klik untuk ubah status penendang #${idx + 1}"
              class="pen-dot-btn h-11 rounded-xl border-2 flex items-center justify-center font-digital text-sm transition-all ${cls}">
              ${label}
            </button>
          `;
        })
        .join('');

      container.querySelectorAll('.pen-dot-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const t = btn.getAttribute('data-team');
          const i = Number(btn.getAttribute('data-idx'));
          const current = state[t].penalties[i];
          const next = current === null ? 'goal' : current === 'goal' ? 'miss' : null;
          state[t].penalties[i] = next;
          renderAll();
          broadcastState();
        });
      });
    }

    function populatePlayerSelects() {
      ['home', 'away'].forEach((teamKey) => {
        const roster = state[teamKey].roster;
        const mainSelect = document.getElementById(`select-${teamKey}-player`);
        const outSelect = document.getElementById(`select-${teamKey}-sub-out`);
        const inSelect = document.getElementById(`select-${teamKey}-sub-in`);

        const optionsHtml = roster
          .map(
            (p, idx) =>
              `<option value="${idx}">#${p.number} - ${p.name} (${p.role})</option>`
          )
          .join('');

        if (mainSelect) {
          const prev = mainSelect.value || '0';
          mainSelect.innerHTML = optionsHtml;
          mainSelect.value = prev;
        }
        if (outSelect) {
          const prev = outSelect.value || '0';
          outSelect.innerHTML = optionsHtml;
          outSelect.value = prev;
        }
        if (inSelect) {
          const prev = inSelect.value || '5';
          inSelect.innerHTML = optionsHtml;
          inSelect.value = prev;
        }
      });
    }

