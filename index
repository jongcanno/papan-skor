    document.getElementById('btn-open-stats').addEventListener('click', () => toggleModal('modal-stats', true));
    document.getElementById('btn-close-stats').addEventListener('click', () => toggleModal('modal-stats', false));
    document.getElementById('remote-open-stats-modal').addEventListener('click', () => {
      toggleModal('modal-remote', false);
      toggleModal('modal-stats', true);
    });

    document.getElementById('btn-open-remote').addEventListener('click', () => toggleModal('modal-remote', true));
    document.getElementById('btn-close-remote').addEventListener('click', () => toggleModal('modal-remote', false));

    document.getElementById('btn-open-shortcuts').addEventListener('click', () => toggleModal('modal-shortcuts', true));
    document.getElementById('btn-close-shortcuts').addEventListener('click', () => toggleModal('modal-shortcuts', false));

    document.getElementById('btn-sound-buzzer').addEventListener('click', playBuzzerSound);

    // Remote Tabs Navigation
    document.querySelectorAll('.remote-tab-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-tab');
        document.querySelectorAll('.remote-tab-pane').forEach((p) => p.classList.add('hidden'));
        document.getElementById(target).classList.remove('hidden');

        document.querySelectorAll('.remote-tab-btn').forEach((b) => {
          b.className = 'remote-tab-btn px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider text-slate-300 hover:text-white transition';
        });
        btn.className = 'remote-tab-btn px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider bg-cyan-500 text-slate-950 transition';
      });
    });

    // Stage & Remote Timer Controls
    function toggleTimer() {
      state.timerRunning = !state.timerRunning;
      renderAll();
      broadcastState();
    }
    function resetTimer() {
      state.timerRunning = false;
      state.timerSeconds = state.defaultTimerSeconds;
      renderAll();
      broadcastState();
    }

    document.getElementById('stage-btn-toggle-timer').addEventListener('click', toggleTimer);
    document.getElementById('stage-btn-reset-timer').addEventListener('click', resetTimer);
    document.getElementById('remote-btn-start').addEventListener('click', () => {
      state.timerRunning = true;
      renderAll();
      broadcastState();
    });
    document.getElementById('remote-btn-pause').addEventListener('click', () => {
      state.timerRunning = false;
      renderAll();
      broadcastState();
    });
    document.getElementById('remote-btn-reset').addEventListener('click', resetTimer);

    document.getElementById('remote-btn-set-timer').addEventListener('click', () => {
      const m = Math.max(0, Number(document.getElementById('input-timer-min').value) || 0);
      const s = Math.max(0, Math.min(59, Number(document.getElementById('input-timer-sec').value) || 0));
      state.timerSeconds = m * 60 + s;
      state.defaultTimerSeconds = state.timerSeconds;
      state.timerRunning = false;
      renderAll();
      broadcastState();
    });

    // Period & Penalty Controls
    document.getElementById('remote-period-plus').addEventListener('click', () => {
      state.period = Math.min(9, state.period + 1);
      renderAll();
      broadcastState();
    });
    document.getElementById('remote-period-minus').addEventListener('click', () => {
      state.period = Math.max(1, state.period - 1);
      renderAll();
      broadcastState();
    });
    document.getElementById('remote-toggle-penalty').addEventListener('click', () => {
      state.penaltyMode = !state.penaltyMode;
      renderAll();
      broadcastState();
    });
    document.getElementById('remote-reset-penalty').addEventListener('click', () => {
      state.home.penalties = [null, null, null, null, null, null, null];
      state.away.penalties = [null, null, null, null, null, null, null];
      renderAll();
      broadcastState();
    });

    // Buzzer & Overlay Controls
    document.getElementById('remote-btn-buzzer').addEventListener('click', playBuzzerSound);
    document.getElementById('remote-btn-timeup').addEventListener('click', () => triggerOverlay({ type: 'TIMEUP' }));
    document.getElementById('remote-btn-hide-overlay').addEventListener('click', hideOverlay);
    document.getElementById('broadcast-overlay').addEventListener('click', hideOverlay);

    // Home & Away Live Buttons
    document.getElementById('remote-home-score-plus').addEventListener('click', () => changeScore('home', 1, true));
    document.getElementById('remote-home-score-minus').addEventListener('click', () => changeScore('home', -1, false));
    document.getElementById('btn-home-goal-overlay').addEventListener('click', () => changeScore('home', 1, true));

    document.getElementById('remote-away-score-plus').addEventListener('click', () => changeScore('away', 1, true));
    document.getElementById('remote-away-score-minus').addEventListener('click', () => changeScore('away', -1, false));
    document.getElementById('btn-away-goal-overlay').addEventListener('click', () => changeScore('away', 1, true));

    document.getElementById('btn-home-yc').addEventListener('click', () => triggerCardAction('home', 'YELLOW'));
    document.getElementById('btn-home-rc').addEventListener('click', () => triggerCardAction('home', 'RED'));
    document.getElementById('btn-away-yc').addEventListener('click', () => triggerCardAction('away', 'YELLOW'));
    document.getElementById('btn-away-rc').addEventListener('click', () => triggerCardAction('away', 'RED'));

    document.getElementById('btn-home-sub').addEventListener('click', () => triggerSubAction('home'));
    document.getElementById('btn-away-sub').addEventListener('click', () => triggerSubAction('away'));

    document.getElementById('btn-home-pen-goal').addEventListener('click', () => recordPenaltyAttempt('home', 'goal'));
    document.getElementById('btn-home-pen-miss').addEventListener('click', () => recordPenaltyAttempt('home', 'miss'));
    document.getElementById('btn-away-pen-goal').addEventListener('click', () => recordPenaltyAttempt('away', 'goal'));
    document.getElementById('btn-away-pen-miss').addEventListener('click', () => recordPenaltyAttempt('away', 'miss'));

    // Team Name & PNG Logo Upload
    document.getElementById('input-home-name').addEventListener('input', (e) => {
      state.home.name = e.target.value.toUpperCase();
      renderAll();
      broadcastState();
    });
    document.getElementById('input-away-name').addEventListener('input', (e) => {
      state.away.name = e.target.value.toUpperCase();
      renderAll();
      broadcastState();
    });

    function handleLogoUpload(inputEl, teamKey) {
      inputEl.addEventListener('change', (e) => {
        const file = e.target.files?.[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = () => {
          state[teamKey].logo = reader.result;
          renderAll();
          broadcastState();
        };
        reader.readAsDataURL(file);
      });
    }
    handleLogoUpload(document.getElementById('input-home-logo'), 'home');
    handleLogoUpload(document.getElementById('input-away-logo'), 'away');

    // AI & Firebase Buttons
    document.getElementById('btn-ai-tactical').addEventListener('click', () => runGeminiAI('tactical'));
    document.getElementById('btn-ai-news').addEventListener('click', () => runGeminiAI('news'));
    document.getElementById('btn-connect-firebase').addEventListener('click', () => {
      const cfg = document.getElementById('input-firebase-config').value.trim();
      const room = document.getElementById('input-room-id').value.trim();
      if (!cfg) {
        state.roomId = (room || 'ARENA-01').toUpperCase();
        renderAll();
        broadcastState();
        alert(`Room ID diperbarui ke ${state.roomId} (Mode Sinkronisasi Lokal/Antar-Tab Aktif). Masukkan JSON Firebase jika ingin menghubungkan ke Cloud Firestore.`);
        return;
      }
      connectFirebase(cfg, room);
    });

    // -------------------------------------------------------------------------
    // 3. KEYBOARD SHORTCUTS ENGINE (NON-CONFLICTING OPERATOR HOTKEYS)
    // -------------------------------------------------------------------------
    window.addEventListener('keydown', (e) => {
      // Ignore shortcuts when typing inside inputs, textareas, or selects
      const tag = document.activeElement?.tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') {
        if (e.key === 'Escape') {
          document.activeElement.blur();
        }
        return;
      }

      const key = e.key;
      const upper = key.toUpperCase();

      switch (key) {
        case ' ':
          e.preventDefault();
          toggleTimer();
          break;
        case 'ArrowUp':
          e.preventDefault();
          state.timerSeconds = Math.min(99 * 60, state.timerSeconds + 60);
          renderAll();
          broadcastState();
          break;
        case 'ArrowDown':
          e.preventDefault();
          state.timerSeconds = Math.max(0, state.timerSeconds - 60);
          renderAll();
          broadcastState();
          break;
        case 'ArrowRight':
          e.preventDefault();
          state.timerSeconds = Math.min(99 * 60 + 59, state.timerSeconds + 1);
          renderAll();
          broadcastState();
          break;
        case 'ArrowLeft':
          e.preventDefault();
          state.timerSeconds = Math.max(0, state.timerSeconds - 1);
          renderAll();
          broadcastState();
          break;
        case 'PageUp':
          e.preventDefault();
          triggerSubAction('home');
          break;
        case 'PageDown':
          e.preventDefault();
          triggerSubAction('away');
          break;
        case 'Escape':
          hideOverlay();
          toggleModal('modal-remote', false);
          toggleModal('modal-stats', false);
          toggleModal('modal-shortcuts', false);
          break;
        default:
          break;
      }

      // Letter Hotkeys
      switch (upper) {
        case 'Q':
          changeScore('home', 1, true);
          break;
        case 'A':
          changeScore('home', -1, false);
          break;
        case 'P':
          changeScore('away', 1, true);
          break;
        case 'L':
          changeScore('away', -1, false);
          break;
        case 'K':
          state.period = Math.min(9, state.period + 1);
          renderAll();
          broadcastState();
          break;
        case 'J':
          state.period = Math.max(1, state.period - 1);
          renderAll();
          broadcastState();
          break;
        case 'T':
          recordPenaltyAttempt('home', 'goal');
          break;
        case 'G':
          recordPenaltyAttempt('home', 'miss');
          break;
        case 'Y':
          recordPenaltyAttempt('away', 'goal');
          break;
        case 'H':
          if (state.penaltyMode && !e.shiftKey) {
            recordPenaltyAttempt('away', 'miss');
          } else {
            toggleModal('modal-remote');
          }
          break;
        case 'M':
          toggleModal('modal-remote');
          break;
        case 'Z':
          triggerCardAction('home', 'YELLOW');
          break;
        case 'X':
          triggerCardAction('away', 'YELLOW');
          break;
        case 'C':
          triggerCardAction('home', 'RED');
          break;
        case 'V':
          triggerCardAction('away', 'RED');
          break;
        default:
          break;
      }
    });

    // Initialize Icons & Initial Render
    lucide.createIcons();
    renderRosterEditor();
    renderAll();
  </script>
</body>
</html>
