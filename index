    // -------------------------------------------------------------------------
    // MATCH ACTIONS (SCORE, PENALTY, CARDS, SUBSTITUTION)
    // -------------------------------------------------------------------------
    function getSelectedPlayer(teamKey, selectId) {
      const sel = document.getElementById(selectId);
      const idx = sel ? Number(sel.value) : 0;
      return state[teamKey].roster[idx] || state[teamKey].roster[0];
    }

    function changeScore(teamKey, delta, withOverlay = true) {
      const next = Math.max(0, state[teamKey].score + delta);
      state[teamKey].score = next;
      if (delta > 0) {
        const sideIdx = teamKey === 'home' ? 0 : 1;
        state.stats.shots[sideIdx] += 1;
        state.stats.shotsOnTarget[sideIdx] += 1;
        if (withOverlay) {
          const p = getSelectedPlayer(teamKey, `select-${teamKey}-player`);
          triggerOverlay({
            type: 'GOAL',
            team: teamKey,
            teamName: state[teamKey].name,
            teamLogo: state[teamKey].logo,
            playerName: p.name,
            playerNumber: p.number
          });
        }
      }
      renderAll();
      broadcastState();
    }

    function recordPenaltyAttempt(teamKey, result) {
      state.penaltyMode = true;
      const arr = state[teamKey].penalties;
      let idx = arr.findIndex((x) => x === null);
      if (idx === -1) {
        state[teamKey].penalties = [result, null, null, null, null, null, null];
      } else {
        state[teamKey].penalties[idx] = result;
      }
      renderAll();
      broadcastState();
    }

    function triggerCardAction(teamKey, cardType) {
      const sideIdx = teamKey === 'home' ? 0 : 1;
      if (cardType === 'YELLOW') {
        state.stats.yellowCards[sideIdx] += 1;
      } else {
        state.stats.redCards[sideIdx] += 1;
      }
      const p = getSelectedPlayer(teamKey, `select-${teamKey}-player`);
      renderAll();
      triggerOverlay({
        type: 'CARD',
        team: teamKey,
        cardType,
        teamName: state[teamKey].name,
        teamLogo: state[teamKey].logo,
        playerName: p.name,
        playerNumber: p.number
      });
    }

    function triggerSubAction(teamKey) {
      const outP = getSelectedPlayer(teamKey, `select-${teamKey}-sub-out`);
      const inP = getSelectedPlayer(teamKey, `select-${teamKey}-sub-in`);
      triggerOverlay({
        type: 'SUB',
        team: teamKey,
        teamName: state[teamKey].name,
        teamLogo: state[teamKey].logo,
        outName: outP.name,
        outNumber: outP.number,
        inName: inP.name,
        inNumber: inP.number
      });
    }

    // -------------------------------------------------------------------------
    // GOOGLE GEMINI AI GENERATOR (TACTICAL COMMENTARY & SPORTS NEWS)
    // -------------------------------------------------------------------------
    async function runGeminiAI(mode) {
      const apiKey = document.getElementById('input-gemini-key').value.trim();
      const outputBox = document.getElementById('ai-output-box');
      outputBox.value = '⏳ Sedang menganalisis data pertandingan real-time...';

      const matchSummary = `
        Pertandingan Futsal / Mini Soccer: ${state.home.name} (${state.home.score}) vs (${state.away.score}) ${state.away.name}.
        Babak ke-${state.period}, Sisa Waktu: ${formatMMSS(state.timerSeconds)}.
        Statistik:
        - Shots: ${state.stats.shots[0]} vs ${state.stats.shots[1]}
        - Shots on Target: ${state.stats.shotsOnTarget[0]} vs ${state.stats.shotsOnTarget[1]}
        - Corners: ${state.stats.corners[0]} vs ${state.stats.corners[1]}
        - Kartu Kuning: ${state.stats.yellowCards[0]} vs ${state.stats.yellowCards[1]}
        - Kartu Merah: ${state.stats.redCards[0]} vs ${state.stats.redCards[1]}
        - Ball Possession: ${state.stats.possession[0]}% vs ${state.stats.possession[1]}%
      `;

      const promptText =
        mode === 'tactical'
          ? `Anda adalah komentator taktis futsal profesional. Berikan komentar taktis singkat (3-4 kalimat tajam dan menarik dalam Bahasa Indonesia) berdasarkan data real-time berikut:\n${matchSummary}`
          : `Anda adalah jurnalis berita olahraga nasional. Buat laporan berita pertandingan futsal lengkap dengan judul utama yang dramatis dan 2 paragraf isi berita berdasarkan data berikut:\n${matchSummary}`;

      if (!apiKey) {
        const leader =
          state.home.score > state.away.score
            ? state.home.name
            : state.away.score > state.home.score
            ? state.away.name
            : 'Kedua tim imbang';

        if (mode === 'tactical') {
          const text = `[ANALISIS TAKTIS AI] Pertarungan sengit di Babak ${state.period}! ${leader} menunjukkan intensitas tinggi dengan penguasaan bola ${state.stats.possession[0]}% berbanding ${state.stats.possession[1]}%. Efektivitas penyelesaian akhir dari ${state.stats.shotsOnTarget[0] + state.stats.shotsOnTarget[1]} total tembakan tepat sasaran menjadi kunci utama jalannya laga ini.`;
          outputBox.value = text;
          state.aiTicker = text;
        } else {
          const text = `LAPORAN UTAMA: DUEL SENGIT ${state.home.name} KONTRA ${state.away.name} BERAKHIR ${state.home.score}-${state.away.score}\n\nArena bergemuruh menyaksikan duel berkelas antara ${state.home.name} menghadapi ${state.away.name} pada babak ke-${state.period}. Kedudukan tercatat ${state.home.score}-${state.away.score} dengan distribusi penguasaan bola ${state.stats.possession[0]}% berbanding ${state.stats.possession[1]}%.\n\nSepanjang laga, ${state.home.name} melepaskan ${state.stats.shots[0]} tembakan (${state.stats.shotsOnTarget[0]} tepat sasaran), sementara ${state.away.name} membalas dengan ${state.stats.shots[1]} percobaan (${state.stats.shotsOnTarget[1]} on target).`;
          outputBox.value = text;
          state.aiTicker = `BERITA TERKINI: ${state.home.name} ${state.home.score} - ${state.away.score} ${state.away.name}`;
        }
        renderAll();
        broadcastState();
        return;
      }

      try {
        const res = await fetch(
          `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=${encodeURIComponent(apiKey)}`,
          {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              contents: [{ parts: [{ text: promptText }] }]
            })
          }
        );
        const data = await res.json();
        const generated =
          data?.candidates?.[0]?.content?.parts?.[0]?.text ||
          'Tidak ada respons dari Gemini API. Periksa API Key Anda.';
        outputBox.value = generated;
        state.aiTicker = generated.split('\n')[0].slice(0, 120);
        renderAll();
        broadcastState();
      } catch (err) {
        outputBox.value = 'Error memanggil Google Gemini API: ' + err.message;
      }
    }

    // -------------------------------------------------------------------------
    // EVENT LISTENERS & UI CONTROLS
    // -------------------------------------------------------------------------
    function toggleModal(id, forceState) {
      const el = document.getElementById(id);
      if (!el) return;
      const isHidden = el.classList.contains('hidden');
      const nextShow = typeof forceState === 'boolean' ? forceState : isHidden;
      if (nextShow) {
        el.classList.remove('hidden');
        el.classList.add('flex');
      } else {
        el.classList.add('hidden');
        el.classList.remove('flex');
      }
    }

