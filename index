<!DOCTYPE html>
<html lang="id" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PRO FUTSAL / MINI SOCCER SCOREBOARD — Premium Dark Neon</title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Google Fonts: Chakra Petch & Outfit -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,500;0,600;0,700;1,700&family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            digital: ['"Chakra Petch"', 'monospace'],
            display: ['"Outfit"', 'sans-serif'],
          },
          colors: {
            neon: {
              cyan: '#00f3ff',
              pink: '#ff007f',
              green: '#00ff66',
              amber: '#ffb800',
              red: '#ff1e42',
            }
          }
        }
      }
    };
  </script>

  <style>
    :root {
      --stage-w: 1600;
      --stage-h: 1200;
    }

    * {
      box-sizing: border-box;
      user-select: none;
    }

    body {
      margin: 0;
      padding: 0;
      background: radial-gradient(circle at 50% 20%, #111827 0%, #050811 55%, #020307 100%);
      color: #f8fafc;
      font-family: 'Outfit', sans-serif;
      overflow: hidden;
      width: 100vw;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Ambient Neon Grid Background */
    .cyber-bg {
      background-image:
        radial-gradient(circle at 18% 30%, rgba(0, 243, 255, 0.08) 0%, transparent 45%),
        radial-gradient(circle at 82% 30%, rgba(255, 0, 127, 0.08) 0%, transparent 45%),
        linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
      background-size: 100% 100%, 100% 100%, 40px 40px, 40px 40px;
    }

    /* 1600x1200 Responsive Broadcast Stage */
    #broadcast-stage {
      width: 1600px;
      height: 1200px;
      position: relative;
      transform-origin: center center;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 0 90px rgba(0, 0, 0, 0.9), inset 0 0 60px rgba(0, 243, 255, 0.04);
    }

    /* Neon LED Text Glows */
    .neon-score-home {
      font-family: 'Chakra Petch', monospace;
      color: #e0ffff;
      text-shadow:
        0 0 12px rgba(0, 243, 255, 0.9),
        0 0 30px rgba(0, 243, 255, 0.65),
        0 0 65px rgba(0, 243, 255, 0.4),
        0 0 110px rgba(0, 243, 255, 0.25);
    }

    .neon-score-away {
      font-family: 'Chakra Petch', monospace;
      color: #ffe5f2;
      text-shadow:
        0 0 12px rgba(255, 0, 127, 0.9),
        0 0 30px rgba(255, 0, 127, 0.65),
        0 0 65px rgba(255, 0, 127, 0.4),
        0 0 110px rgba(255, 0, 127, 0.25);
    }

    .neon-timer {
      font-family: 'Chakra Petch', monospace;
      color: #ffffff;
      text-shadow:
        0 0 10px rgba(0, 255, 102, 0.85),
        0 0 28px rgba(0, 255, 102, 0.5),
        0 0 60px rgba(0, 255, 102, 0.25);
    }

    .neon-timer-danger {
      font-family: 'Chakra Petch', monospace;
      color: #ffe4e8;
      text-shadow:
        0 0 12px rgba(255, 30, 66, 0.95),
        0 0 32px rgba(255, 30, 66, 0.7),
        0 0 70px rgba(255, 30, 66, 0.45);
    }

    .neon-box {
      background: linear-gradient(180deg, rgba(15, 23, 42, 0.88) 0%, rgba(7, 11, 22, 0.95) 100%);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.65), inset 0 1px 1px rgba(255, 255, 255, 0.15);
    }

    /* Fullscreen Broadcast Overlay Animation (Left to Right Sweep) */
    .overlay-sweep {
      transform: translateX(-105%);
      opacity: 0;
      pointer-events: none;
      transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.35s ease;
    }

    .overlay-sweep.active {
      transform: translateX(0%);
      opacity: 1;
      pointer-events: auto;
    }

    .overlay-sweep.exit-right {
      transform: translateX(105%);
      opacity: 0;
    }

    /* Penalty Dot Glows */
    .pen-dot-goal {
      background: #00ff66;
      box-shadow: 0 0 16px #00ff66, 0 0 30px rgba(0, 255, 102, 0.6);
      border-color: #86efac;
    }

    .pen-dot-miss {
      background: #ff1e42;
      box-shadow: 0 0 16px #ff1e42, 0 0 30px rgba(255, 30, 66, 0.6);
      border-color: #fda4af;
    }

    /* Custom Scrollbar for Modals / Remote */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: rgba(15, 23, 42, 0.6);
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(0, 243, 255, 0.35);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(0, 243, 255, 0.65);
    }

    @keyframes pulse-fast {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.04); }
    }
    .animate-goal-text {
      animation: pulse-fast 0.8s infinite ease-in-out;
    }
  </style>
</head>
<body>

  <!-- =========================================================================
       1600x1200 BROADCAST DISPLAY STAGE (4:3 HI-RES)
  ========================================================================== -->
  <div id="broadcast-stage" class="cyber-bg flex flex-col justify-between p-10 select-none">

    <!-- TOP HEADER: Minimalist Trophy Center + Right Action Icons -->
    <header class="relative flex items-center justify-between h-20 px-6 rounded-2xl neon-box border-white/10">
      <!-- Left Status Badge: Sync / Mode -->
      <div class="flex items-center gap-3">
        <span id="sync-indicator" class="w-3 h-3 rounded-full bg-emerald-400 shadow-[0_0_12px_#34d399]"></span>
        <span id="sync-label" class="text-xs font-semibold tracking-widest uppercase text-slate-300">
          LOCAL + BROADCAST SYNC READY
        </span>
        <span id="room-badge" class="px-2.5 py-1 text-xs font-digital font-bold rounded bg-cyan-500/15 text-cyan-300 border border-cyan-500/30">
          ROOM: ARENA-01
        </span>
      </div>

      <!-- Center Minimalist Trophy Icon & Competition Title -->
      <div class="absolute left-1/2 -translate-x-1/2 flex items-center gap-3.5">
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-amber-400/20 to-yellow-600/20 border border-amber-400/40 flex items-center justify-center shadow-[0_0_25px_rgba(251,191,36,0.3)]">
          <i data-lucide="trophy" class="w-6 h-6 text-amber-400"></i>
        </div>
        <div class="text-center">
          <div id="tournament-title" class="text-sm font-extrabold tracking-[0.28em] uppercase text-amber-300/90">
            PRO FUTSAL CHAMPIONSHIP
          </div>
          <div class="text-[11px] tracking-[0.2em] text-slate-400 uppercase">
            OFFICIAL DIGITAL SCOREBOARD
          </div>
        </div>
      </div>

      <!-- Top Right Control Icons: Statistik, Remote, Buzzer, Bantuan Keyboard -->
      <div class="flex items-center gap-2.5">
        <button id="btn-open-stats" title="Statistik Pertandingan (In The Match)"
          class="group flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-slate-800/80 hover:bg-cyan-500/20 border border-white/10 hover:border-cyan-400/50 transition-all">
          <i data-lucide="bar-chart-3" class="w-5 h-5 text-cyan-400 group-hover:scale-110 transition-transform"></i>
          <span class="text-xs font-semibold tracking-wider text-slate-200">STATISTIK</span>
        </button>

        <button id="btn-open-remote" title="Panel Remote Controller (M)"
          class="group flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-slate-800/80 hover:bg-pink-500/20 border border-white/10 hover:border-pink-400/50 transition-all">
          <i data-lucide="Sliders" class="w-5 h-5 text-pink-400 group-hover:scale-110 transition-transform"></i>
          <span class="text-xs font-semibold tracking-wider text-slate-200">REMOTE</span>
        </button>

        <button id="btn-sound-buzzer" title="Bunyikan Buzzer Horn"
          class="group flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-slate-800/80 hover:bg-amber-500/20 border border-white/10 hover:border-amber-400/50 transition-all">
          <i data-lucide="volume-2" class="w-5 h-5 text-amber-400 group-hover:scale-110 transition-transform"></i>
          <span class="text-xs font-semibold tracking-wider text-slate-200">BUZZER</span>
        </button>

        <button id="btn-open-shortcuts" title="Bantuan Shortcut Keyboard (?)"
          class="group flex items-center justify-center w-10 h-10 rounded-xl bg-slate-800/80 hover:bg-emerald-500/20 border border-white/10 hover:border-emerald-400/50 transition-all">
          <i data-lucide="keyboard" class="w-5 h-5 text-emerald-400 group-hover:scale-110 transition-transform"></i>
        </button>
      </div>
    </header>

    <!-- MAIN ARENA DISPLAY GRID: Left (Home) | Center (Timer & Period) | Right (Away) -->
    <main class="grid grid-cols-12 gap-8 items-center my-auto py-4">

      <!-- ======================== HOME TEAM (LEFT) ======================== -->
      <section class="col-span-4 flex flex-col items-center justify-between neon-box rounded-3xl p-8 border-t-4 border-t-cyan-400 relative overflow-hidden min-h-[820px]">
        <div class="absolute -top-24 -left-24 w-64 h-64 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Home Badge + Team Logo -->
        <div class="flex flex-col items-center w-full">
          <span class="px-4 py-1 rounded-full text-xs font-bold tracking-[0.25em] uppercase bg-cyan-500/15 text-cyan-300 border border-cyan-400/30 mb-5">
            HOME TEAM
          </span>

          <div class="w-44 h-44 rounded-3xl bg-slate-900/90 border-2 border-cyan-400/30 shadow-[0_0_40px_rgba(0,243,255,0.18)] flex items-center justify-center p-4 mb-5 overflow-hidden">
            <img id="display-home-logo" src="" alt="Home Logo" class="w-full h-full object-contain drop-shadow-[0_0_12px_rgba(0,243,255,0.5)]" />
          </div>

          <h2 id="display-home-name" class="text-4xl font-black tracking-wider uppercase text-center text-white drop-shadow-[0_2px_10px_rgba(0,243,255,0.35)] line-clamp-1">
            GARUDA MUDA FC
          </h2>
        </div>

        <!-- Giant Neon LED Score -->
        <div class="my-2 flex items-center justify-center">
          <div id="display-home-score" class="text-[210px] leading-none font-bold neon-score-home select-none">
            0
          </div>
        </div>

        <!-- Quick Foul / Card Pills -->
        <div class="flex items-center gap-4 mb-3">
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-amber-500/10 border border-amber-400/30">
            <span class="w-3 h-4 rounded-sm bg-amber-400 inline-block shadow-[0_0_8px_#fbbf24]"></span>
            <span class="text-xs uppercase tracking-wider text-slate-300">Kuning:</span>
            <span id="display-home-yc" class="font-digital font-bold text-lg text-amber-300">0</span>
          </div>
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-rose-500/10 border border-rose-500/30">
            <span class="w-3 h-4 rounded-sm bg-rose-500 inline-block shadow-[0_0_8px_#f43f5e]"></span>
            <span class="text-xs uppercase tracking-wider text-slate-300">Merah:</span>
            <span id="display-home-rc" class="font-digital font-bold text-lg text-rose-400">0</span>
          </div>
        </div>

        <!-- Penalty Shootout 7-Dot Indicator Grid (Home) -->
        <div id="home-penalty-panel" class="w-full pt-4 border-t border-white/10 transition-opacity duration-300">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold uppercase tracking-[0.2em] text-cyan-300/90">ADU PENALTI (7 PENENDANG)</span>
            <span id="display-home-pen-score" class="text-sm font-digital font-bold text-cyan-300">0 / 0</span>
          </div>
          <div id="display-home-pen-dots" class="grid grid-cols-7 gap-2.5">
            <!-- Populated via JS -->
          </div>
        </div>
      </section>

      <!-- ======================== CENTER TIMER & PERIOD ======================== -->
      <section class="col-span-4 flex flex-col items-center justify-center gap-7">

        <!-- Digital Countdown Timer Box -->
        <div class="w-full neon-box rounded-3xl p-8 border-2 border-emerald-400/30 shadow-[0_0_60px_rgba(0,255,102,0.12)] flex flex-col items-center relative overflow-hidden">
          <div class="flex items-center gap-2.5 mb-2">
            <span id="timer-status-dot" class="w-2.5 h-2.5 rounded-full bg-slate-500"></span>
            <span id="timer-status-text" class="text-xs font-bold tracking-[0.3em] uppercase text-slate-400">
              READY / PAUSED
            </span>
          </div>

          <div id="display-timer" class="text-[128px] leading-none font-bold tracking-wider neon-timer my-2">
            20:00
          </div>

          <!-- Quick On-Screen Timer Controls for Convenience -->
          <div class="flex items-center gap-3 mt-4">
            <button id="stage-btn-toggle-timer" class="px-5 py-2 rounded-xl bg-emerald-500/20 hover:bg-emerald-500/35 border border-emerald-400/40 text-emerald-300 text-xs font-bold tracking-widest uppercase transition">
              START / PAUSE (SPACE)
            </button>
            <button id="stage-btn-reset-timer" class="px-4 py-2 rounded-xl bg-slate-800/90 hover:bg-slate-700 border border-white/15 text-slate-300 text-xs font-bold tracking-widest uppercase transition">
              RESET
            </button>
          </div>
        </div>

        <!-- Period / Babak Indicator Box -->
        <div class="w-full neon-box rounded-3xl p-7 border border-white/15 flex flex-col items-center">
          <span class="text-xs font-bold tracking-[0.35em] uppercase text-slate-400 mb-2">
            BABAK PERTANDINGAN
          </span>
          <div class="flex items-center gap-6">
            <div class="px-5 py-1.5 rounded-xl bg-amber-400/10 border border-amber-400/30 text-amber-300 font-bold text-sm tracking-widest uppercase" id="display-period-label">
              BABAK KE-
            </div>
            <div id="display-period" class="text-8xl leading-none font-digital font-bold text-amber-400 drop-shadow-[0_0_25px_rgba(251,191,36,0.7)]">
              1
            </div>
          </div>
          <div id="penalty-mode-banner" class="hidden mt-4 px-4 py-1.5 rounded-full bg-rose-500/20 border border-rose-400/40 text-rose-300 text-xs font-extrabold tracking-[0.25em] uppercase animate-pulse">
            ★ MODE ADU PENALTI AKTIF ★
          </div>
        </div>

        <!-- Live Match Possession & AI Tactical Ticker -->
        <div class="w-full neon-box rounded-3xl p-6 border border-white/10">
          <div class="flex items-center justify-between text-xs font-bold tracking-wider uppercase text-slate-400 mb-2">
            <span class="text-cyan-300" id="mini-poss-home">50%</span>
            <span class="tracking-[0.25em] text-slate-300">BALL POSSESSION</span>
            <span class="text-pink-400" id="mini-poss-away">50%</span>
          </div>
          <div class="w-full h-3.5 rounded-full bg-slate-800 overflow-hidden flex p-0.5 border border-white/10">
            <div id="mini-poss-bar-home" class="h-full bg-gradient-to-r from-cyan-500 to-cyan-300 rounded-l-full transition-all duration-500" style="width: 50%"></div>
            <div id="mini-poss-bar-away" class="h-full bg-gradient-to-l from-pink-500 to-rose-400 rounded-r-full transition-all duration-500" style="width: 50%"></div>
          </div>

          <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between">
            <div class="flex items-center gap-2 text-xs text-slate-300 truncate">
              <i data-lucide="sparkles" class="w-4 h-4 text-amber-400 shrink-0"></i>
              <span id="ai-ticker-text" class="truncate">Tekan tombol Remote (M) untuk analisis taktis AI & kontrol penuh.</span>
            </div>
          </div>
        </div>
      </section>

      <!-- ======================== AWAY TEAM (RIGHT) ======================== -->
      <section class="col-span-4 flex flex-col items-center justify-between neon-box rounded-3xl p-8 border-t-4 border-t-pink-500 relative overflow-hidden min-h-[820px]">
        <div class="absolute -top-24 -right-24 w-64 h-64 bg-pink-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Away Badge + Team Logo -->
        <div class="flex flex-col items-center w-full">
          <span class="px-4 py-1 rounded-full text-xs font-bold tracking-[0.25em] uppercase bg-pink-500/15 text-pink-300 border border-pink-400/30 mb-5">
            AWAY TEAM
          </span>

          <div class="w-44 h-44 rounded-3xl bg-slate-900/90 border-2 border-pink-500/30 shadow-[0_0_40px_rgba(255,0,127,0.18)] flex items-center justify-center p-4 mb-5 overflow-hidden">
            <img id="display-away-logo" src="" alt="Away Logo" class="w-full h-full object-contain drop-shadow-[0_0_12px_rgba(255,0,127,0.5)]" />
          </div>

          <h2 id="display-away-name" class="text-4xl font-black tracking-wider uppercase text-center text-white drop-shadow-[0_2px_10px_rgba(255,0,127,0.35)] line-clamp-1">
            BINTANG TIMUR FC
          </h2>
        </div>

        <!-- Giant Neon LED Score -->
        <div class="my-2 flex items-center justify-center">
          <div id="display-away-score" class="text-[210px] leading-none font-bold neon-score-away select-none">
            0
          </div>
        </div>

        <!-- Quick Foul / Card Pills -->
        <div class="flex items-center gap-4 mb-3">
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-amber-500/10 border border-amber-400/30">
            <span class="w-3 h-4 rounded-sm bg-amber-400 inline-block shadow-[0_0_8px_#fbbf24]"></span>
            <span class="text-xs uppercase tracking-wider text-slate-300">Kuning:</span>
            <span id="display-away-yc" class="font-digital font-bold text-lg text-amber-300">0</span>
          </div>
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-rose-500/10 border border-rose-500/30">
            <span class="w-3 h-4 rounded-sm bg-rose-500 inline-block shadow-[0_0_8px_#f43f5e]"></span>
            <span class="text-xs uppercase tracking-wider text-slate-300">Merah:</span>
            <span id="display-away-rc" class="font-digital font-bold text-lg text-rose-400">0</span>
          </div>
        </div>

        <!-- Penalty Shootout 7-Dot Indicator Grid (Away) -->
        <div id="away-penalty-panel" class="w-full pt-4 border-t border-white/10 transition-opacity duration-300">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold uppercase tracking-[0.2em] text-pink-300/90">ADU PENALTI (7 PENENDANG)</span>
            <span id="display-away-pen-score" class="text-sm font-digital font-bold text-pink-300">0 / 0</span>
          </div>
          <div id="display-away-pen-dots" class="grid grid-cols-7 gap-2.5">
            <!-- Populated via JS -->
          </div>
        </div>
      </section>
    </main>

    <!-- FOOTER SHORTCUT BAR -->
    <footer class="h-14 px-6 rounded-2xl neon-box border-white/10 flex items-center justify-between text-xs text-slate-400">
      <div class="flex items-center gap-4 flex-wrap">
        <span><kbd class="px-2 py-0.5 rounded bg-slate-800 text-cyan-300 border border-white/15 font-digital">SPACE</kbd> Start/Pause</span>
        <span><kbd class="px-2 py-0.5 rounded bg-slate-800 text-cyan-300 border border-white/15 font-digital">Q/A</kbd> Skor Home</span>
        <span><kbd class="px-2 py-0.5 rounded bg-slate-800 text-pink-300 border border-white/15 font-digital">P/L</kbd> Skor Away</span>
        <span><kbd class="px-2 py-0.5 rounded bg-slate-800 text-amber-300 border border-white/15 font-digital">K/J</kbd> Babak</span>
        <span><kbd class="px-2 py-0.5 rounded bg-slate-800 text-emerald-300 border border-white/15 font-digital">T/G</kbd> Pen. Home</span>
        <span><kbd class="px-2 py-0.5 rounded bg-slate-800 text-emerald-300 border border-white/15 font-digital">Y/H</kbd> Pen. Away</span>
        <span><kbd class="px-2 py-0.5 rounded bg-slate-800 text-yellow-300 border border-white/15 font-digital">Z/X</kbd> Kuning</span>
        <span><kbd class="px-2 py-0.5 rounded bg-slate-800 text-rose-400 border border-white/15 font-digital">C/V</kbd> Merah</span>
        <span><kbd class="px-2 py-0.5 rounded bg-slate-800 text-purple-300 border border-white/15 font-digital">PgUp/PgDn</kbd> Substitusi</span>
      </div>
      <div class="flex items-center gap-2">
        <span><kbd class="px-2 py-0.5 rounded bg-slate-800 text-white border border-white/20 font-digital">M</kbd> Remote Panel</span>
      </div>
    </footer>

    <!-- =======================================================================
         4. FULLSCREEN ANIMATED POP-UP OVERLAYS (LEFT-TO-RIGHT SWEEP)
    ======================================================================== -->

    <!-- OVERLAY: GOAL / KARTU / SUBSTITUSI / WAKTU HABIS -->
    <div id="broadcast-overlay" class="overlay-sweep absolute inset-0 z-40 flex items-center justify-center bg-slate-950/92 backdrop-blur-xl p-12">
      <!-- Dynamic Content Injected by JS -->
      <div id="broadcast-overlay-content" class="w-full max-w-5xl"></div>
    </div>

  </div><!-- /#broadcast-stage -->

  <!-- =========================================================================
       5. MODAL STATISTIK LENGKAP ("IN THE MATCH")
  ========================================================================== -->
  <div id="modal-stats" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-md p-6">
    <div class="w-full max-w-4xl neon-box rounded-3xl border border-cyan-400/30 p-8 shadow-2xl relative overflow-hidden">
      <!-- Header -->
      <div class="flex items-center justify-between pb-6 border-b border-white/10">
        <div class="flex items-center gap-3">
          <div class="p-2.5 rounded-xl bg-cyan-500/20 border border-cyan-400/40">
            <i data-lucide="bar-chart-3" class="w-6 h-6 text-cyan-300"></i>
          </div>
          <div>
            <h3 class="text-2xl font-black tracking-[0.2em] uppercase text-white">IN THE MATCH — STATISTICS</h3>
            <p class="text-xs text-slate-400 tracking-wider uppercase">Perbandingan Statistik Real-Time Pertandingan</p>
