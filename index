        <path d="M100 12 L174 42 L174 108 C174 150 142 178 100 190 C58 178 26 150 26 108 L26 42 Z" fill="url(#hg)" stroke="#e0f2fe" stroke-width="6"/>
        <path d="M100 32 L154 54 L154 105 C154 138 130 158 100 168 C70 158 46 138 46 105 L46 54 Z" fill="#082f49"/>
        <polygon points="100,52 114,82 146,86 122,108 128,140 100,124 72,140 78,108 54,86 86,82" fill="#00f3ff"/>
      </svg>
    `);

    const DEFAULT_AWAY_LOGO = `data:image/svg+xml;utf8,` + encodeURIComponent(`
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200">
        <defs>
          <linearGradient id="ag" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#ff007f"/>
            <stop offset="100%" stop-color="#9d174d"/>
          </linearGradient>
        </defs>
        <path d="M100 12 L174 42 L174 108 C174 150 142 178 100 190 C58 178 26 150 26 108 L26 42 Z" fill="url(#ag)" stroke="#fce7f3" stroke-width="6"/>
        <path d="M100 32 L154 54 L154 105 C154 138 130 158 100 168 C70 158 46 138 46 105 L46 54 Z" fill="#4c0519"/>
        <polygon points="100,52 114,82 146,86 122,108 128,140 100,124 72,140 78,108 54,86 86,82" fill="#ff007f"/>
      </svg>
    `);

    // -------------------------------------------------------------------------
    // INITIAL APPLICATION STATE (9 Quota Roster per Team: 5 Utama, 2 Cadangan, 2 Official)
    // -------------------------------------------------------------------------
    const createDefaultRoster = (prefix) => [
      { id: 1, role: 'Utama 1 (GK)', number: '1', name: `${prefix} Alfarizi` },
      { id: 2, role: 'Utama 2 (Anchor)', number: '4', name: `${prefix} Rizky` },
      { id: 3, role: 'Utama 3 (Flank)', number: '7', name: `${prefix} Ardiansyah` },
      { id: 4, role: 'Utama 4 (Flank)', number: '10', name: `${prefix} Evan Soumilena` },
      { id: 5, role: 'Utama 5 (Pivot)', number: '9', name: `${prefix} Samuel Eko` },
      { id: 6, role: 'Cadangan 1', number: '12', name: `${prefix} Iqbal Iskandar` },
      { id: 7, role: 'Cadangan 2', number: '14', name: `${prefix} Wendy Brian` },
      { id: 8, role: 'Official 1 (Head Coach)', number: 'HC', name: `Coach ${prefix} Kensuke` },
      { id: 9, role: 'Official 2 (Manager)', number: 'MGR', name: `Mgr. ${prefix} Pratama` },
    ];

    const state = {
      roomId: 'ARENA-01',
      timerSeconds: 20 * 60,
      defaultTimerSeconds: 20 * 60,
      timerRunning: false,
      period: 1,
      penaltyMode: false,
      aiTicker: 'Tekan tombol Remote (M) untuk analisis taktis AI & kontrol penuh.',
      home: {
        name: 'GARUDA MUDA FC',
        logo: DEFAULT_HOME_LOGO,
        score: 0,
        penalties: [null, null, null, null, null, null, null], // 7 slots: 'goal' | 'miss' | null
        roster: createDefaultRoster('GM')
      },
      away: {
        name: 'BINTANG TIMUR FC',
        logo: DEFAULT_AWAY_LOGO,
        score: 0,
        penalties: [null, null, null, null, null, null, null],
        roster: createDefaultRoster('BT')
      },
      stats: {
        shots: [6, 5],
        shotsOnTarget: [4, 3],
        corners: [3, 2],
        yellowCards: [0, 0],
        redCards: [0, 0],
        possession: [52, 48]
      },
      lastOverlayEvent: null
    };

    // Load persisted state from localStorage if available
    const STORAGE_KEY = 'FUTSAL_PRO_SCOREBOARD_STATE_V1';
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        const parsed = JSON.parse(saved);
        Object.assign(state, parsed);
        state.timerRunning = false; // Always start paused on reload
      }
    } catch (e) {
      console.warn('Could not load saved state:', e);
    }

    // -------------------------------------------------------------------------
    // RESPONSIVE 1600x1200 SCALING ENGINE
    // -------------------------------------------------------------------------
    function fitBroadcastStage() {
      const stage = document.getElementById('broadcast-stage');
      if (!stage) return;
      const scaleX = window.innerWidth / 1600;
      const scaleY = window.innerHeight / 1200;
      const scale = Math.min(scaleX, scaleY) * 0.985;
      stage.style.transform = `scale(${scale})`;
    }
    window.addEventListener('resize', fitBroadcastStage);
    fitBroadcastStage();

    // -------------------------------------------------------------------------
    // WEB AUDIO SYNTHESIZER (BUZZER HORN, GOAL SIREN, WHISTLE) & TTS
    // -------------------------------------------------------------------------
    let audioCtx = null;
    function getAudioCtx() {
      if (!audioCtx) {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        audioCtx = new AudioContextClass();
      }
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      return audioCtx;
    }

    function playBuzzerSound() {
      try {
        const ctx = getAudioCtx();
        const now = ctx.currentTime;
        const freqs = [145, 290, 435];
        freqs.forEach((f) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(f, now);
          gain.gain.setValueAtTime(0.18, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 1.6);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(now);
          osc.stop(now + 1.65);
        });
      } catch (e) {
        console.warn('Audio play blocked:', e);
      }
    }

    function playCardWhistle() {
      try {
        const ctx = getAudioCtx();
        const now = ctx.currentTime;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(2800, now);
        osc.frequency.linearRampToValueAtTime(2550, now + 0.35);
        gain.gain.setValueAtTime(0.2, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now);
        osc.stop(now + 0.42);
      } catch (e) {}
    }

    function speakTTS(text) {
      try {
        if ('speechSynthesis' in window) {
          window.speechSynthesis.cancel();
          const utter = new SpeechSynthesisUtterance(text);
          utter.lang = 'id-ID';
          utter.rate = 1.02;
          utter.pitch = 1.1;
          window.speechSynthesis.speak(utter);
        }
      } catch (e) {
        console.warn('TTS error:', e);
      }
    }

    // -------------------------------------------------------------------------
    // REAL-TIME MULTI-DEVICE SYNC (BroadcastChannel + Firebase Firestore)
    // -------------------------------------------------------------------------
    const localChannel = new BroadcastChannel('FUTSAL_SCOREBOARD_CHANNEL');
    let firestoreDb = null;
    let firestoreUnsub = null;
    let isApplyingRemoteUpdate = false;

    localChannel.onmessage = (ev) => {
      if (ev.data && ev.data.type === 'STATE_SYNC') {
        isApplyingRemoteUpdate = true;
        const incomingOverlay = ev.data.payload.lastOverlayEvent;
        const prevOverlayId = state.lastOverlayEvent?.id;
        Object.assign(state, ev.data.payload);
        renderAll();
        if (incomingOverlay && incomingOverlay.id !== prevOverlayId) {
          showOverlayFromEvent(incomingOverlay, false);
        }
        isApplyingRemoteUpdate = false;
      }
    };

    async function connectFirebase(configJsonStr, roomId) {
      try {
        const firebaseConfig = JSON.parse(configJsonStr);
        const app = initializeApp(firebaseConfig, 'scoreboard-' + Date.now());
        firestoreDb = getFirestore(app);
        state.roomId = (roomId || 'ARENA-01').trim().toUpperCase();

        if (firestoreUnsub) firestoreUnsub();
        const roomRef = doc(firestoreDb, 'futsal_scoreboards', state.roomId);

        firestoreUnsub = onSnapshot(roomRef, (snap) => {
          if (!snap.exists()) {
            broadcastState();
            return;
          }
          const data = snap.data();
          isApplyingRemoteUpdate = true;
          const prevOverlayId = state.lastOverlayEvent?.id;
          Object.assign(state, data);
          renderAll();
          if (data.lastOverlayEvent && data.lastOverlayEvent.id !== prevOverlayId) {
            showOverlayFromEvent(data.lastOverlayEvent, false);
          }
          isApplyingRemoteUpdate = false;
        });

        document.getElementById('sync-label').textContent = 'FIREBASE CLOUD LIVE SYNC';
        document.getElementById('firebase-status-detail').textContent = `Terhubung ke Firestore Room: ${state.roomId}`;
        renderAll();
      } catch (err) {
        alert('Gagal menghubungkan Firebase Config JSON: ' + err.message);
      }
    }

    async function broadcastState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      } catch (e) {}

      if (!isApplyingRemoteUpdate) {
        localChannel.postMessage({
          type: 'STATE_SYNC',
          payload: JSON.parse(JSON.stringify(state))
        });

        if (firestoreDb) {
          try {
            const roomRef = doc(firestoreDb, 'futsal_scoreboards', state.roomId);
            await setDoc(roomRef, JSON.parse(JSON.stringify(state)), { merge: true });
          } catch (e) {
            console.warn('Firestore sync error:', e);
          }
        }
      }
    }

    // -------------------------------------------------------------------------
    // FULLSCREEN ANIMATED OVERLAYS (LEFT-TO-RIGHT SWEEP)
    // -------------------------------------------------------------------------
    let overlayTimeout = null;

    function triggerOverlay(eventPayload) {
      const fullEvent = {
        ...eventPayload,
        id: Date.now() + '-' + Math.random().toString(36).slice(2, 6)
      };
      state.lastOverlayEvent = fullEvent;
      showOverlayFromEvent(fullEvent, true);
      broadcastState();
    }

    function hideOverlay() {
      const overlay = document.getElementById('broadcast-overlay');
      if (!overlay.classList.contains('active')) return;
      overlay.classList.add('exit-right');
      overlay.classList.remove('active');
      setTimeout(() => {
        overlay.classList.remove('exit-right');
      }, 550);
    }

    function showOverlayFromEvent(ev, playAudio = true) {
      const overlay = document.getElementById('broadcast-overlay');
      const container = document.getElementById('broadcast-overlay-content');
      if (overlayTimeout) clearTimeout(overlayTimeout);

      overlay.classList.remove('exit-right');

      if (ev.type === 'GOAL') {
        const isHome = ev.team === 'home';
        if (playAudio) {
          speakTTS(`Gooool! Dicetak oleh nomor punggung ${ev.playerNumber}, ${ev.playerName}, untuk ${ev.teamName}!`);
        }
        container.innerHTML = `
          <div class="neon-box rounded-3xl p-12 border-4 ${isHome ? 'border-cyan-400 shadow-[0_0_90px_rgba(0,243,255,0.45)]' : 'border-pink-500 shadow-[0_0_90px_rgba(255,0,127,0.45)]'} flex flex-col items-center text-center relative overflow-hidden">
            <div class="text-sm font-black tracking-[0.4em] uppercase ${isHome ? 'text-cyan-300' : 'text-pink-400'} mb-3">
              ★ ${ev.teamName} SCORES! ★
            </div>
            <h1 class="text-[115px] leading-none font-digital font-black italic tracking-wider ${isHome ? 'neon-score-home' : 'neon-score-away'} animate-goal-text mb-8">
              GOOOAAAAL!!!!!!
            </h1>
            <div class="flex items-center gap-8 bg-slate-900/90 px-10 py-6 rounded-3xl border border-white/15">
              <img src="${ev.teamLogo}" alt="Avatar" class="w-28 h-28 object-contain rounded-2xl bg-slate-950 p-3 border border-white/10" />
              <div class="text-left">
                <div class="text-xs font-bold uppercase tracking-[0.25em] text-slate-400">PENCETAK GOL</div>
                <div class="text-5xl font-black text-white uppercase mt-1">${ev.playerName}</div>
                <div class="text-2xl font-digital font-bold ${isHome ? 'text-cyan-300' : 'text-pink-400'} mt-1">
                  NOMOR PUNGGUNG #${ev.playerNumber}
                </div>
              </div>
            </div>
          </div>
        `;
      } else if (ev.type === 'CARD') {
        const isYellow = ev.cardType === 'YELLOW';
        if (playAudio) playCardWhistle();
        container.innerHTML = `
          <div class="neon-box rounded-3xl p-12 border-4 ${isYellow ? 'border-amber-400 shadow-[0_0_80px_rgba(251,191,36,0.4)]' : 'border-rose-500 shadow-[0_0_80px_rgba(244,63,94,0.45)]'} flex items-center justify-between gap-10">
            <div class="flex items-center gap-8">
              <div class="w-32 h-44 rounded-2xl ${isYellow ? 'bg-amber-400 shadow-[0_0_45px_#fbbf24]' : 'bg-rose-600 shadow-[0_0_45px_#e11d48]'} border-4 border-white/40 shrink-0"></div>
              <div>
                <div class="text-sm font-black tracking-[0.35em] uppercase ${isYellow ? 'text-amber-300' : 'text-rose-400'}">
                  DISCIPLINARY ACTION • ${ev.teamName}
                </div>
                <h2 class="text-7xl font-black uppercase text-white mt-2">
                  ${isYellow ? 'KARTU KUNING' : 'KARTU MERAH'}
                </h2>
                <div class="mt-4 flex items-center gap-4">
                  <span class="px-5 py-2 rounded-xl bg-slate-900 border border-white/15 font-digital font-bold text-4xl text-white">
                    #${ev.playerNumber}
                  </span>
                  <span class="text-4xl font-extrabold text-slate-100 uppercase">
                    ${ev.playerName}
                  </span>
                </div>
              </div>
            </div>
            <img src="${ev.teamLogo}" class="w-36 h-36 object-contain opacity-90" />
          </div>
        `;
      } else if (ev.type === 'SUB') {
        if (playAudio) playCardWhistle();
        container.innerHTML = `
          <div class="neon-box rounded-3xl p-12 border-4 border-purple-400/60 shadow-[0_0_80px_rgba(168,85,247,0.35)] space-y-8">
            <div class="flex items-center justify-between border-b border-white/10 pb-5">
              <div class="flex items-center gap-4">
                <img src="${ev.teamLogo}" class="w-16 h-16 object-contain" />
                <div>
                  <div class="text-xs font-bold tracking-[0.3em] uppercase text-purple-300">PERGANTIAN PEMAIN (SUBSTITUSI)</div>
                  <h2 class="text-4xl font-black uppercase text-white">${ev.teamName}</h2>
                </div>
              </div>
              <span class="px-4 py-1.5 rounded-full bg-purple-500/20 border border-purple-400/40 text-purple-200 text-xs font-bold uppercase tracking-widest">
                OFFICIAL SUBSTITUTION
