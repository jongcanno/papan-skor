                <div class="w-full h-3.5 rounded-full bg-slate-900 overflow-hidden flex p-0.5 border border-white/10">
                  <div class="h-full bg-gradient-to-r from-cyan-500 to-cyan-300 rounded-l-full transition-all duration-500" style="width: ${hPct}%"></div>
                  <div class="h-full bg-gradient-to-l from-pink-500 to-rose-400 rounded-r-full transition-all duration-500" style="width: ${aPct}%"></div>
                </div>
              </div>
            `;
          })
          .join('');
      }

      // 2. Render Remote Editor
      const editorEl = document.getElementById('remote-stats-editor');
      if (editorEl) {
        editorEl.innerHTML = metrics
          .map((m) => {
            const [hVal, aVal] = state.stats[m.key];
            return `
              <div class="grid grid-cols-12 items-center gap-4 p-3 rounded-xl bg-slate-950/70 border border-white/10">
                <div class="col-span-4 flex items-center gap-2">
                  <button data-stat="${m.key}" data-side="0" data-delta="-1" class="stat-step-btn w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 font-bold">-</button>
                  <span class="font-digital font-bold text-lg text-cyan-300 w-12 text-center">${hVal}${m.isPercent ? '%' : ''}</span>
                  <button data-stat="${m.key}" data-side="0" data-delta="1" class="stat-step-btn w-8 h-8 rounded-lg bg-cyan-500/20 text-cyan-300 border border-cyan-400/30 font-bold">+</button>
                </div>
                <div class="col-span-4 text-center text-xs font-bold uppercase tracking-wider text-slate-300">
                  ${m.label}
                </div>
                <div class="col-span-4 flex items-center justify-end gap-2">
                  <button data-stat="${m.key}" data-side="1" data-delta="-1" class="stat-step-btn w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 font-bold">-</button>
                  <span class="font-digital font-bold text-lg text-pink-400 w-12 text-center">${aVal}${m.isPercent ? '%' : ''}</span>
                  <button data-stat="${m.key}" data-side="1" data-delta="1" class="stat-step-btn w-8 h-8 rounded-lg bg-pink-500/20 text-pink-300 border border-pink-400/30 font-bold">+</button>
                </div>
              </div>
            `;
          })
          .join('');

        editorEl.querySelectorAll('.stat-step-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const key = btn.getAttribute('data-stat');
            const side = Number(btn.getAttribute('data-side'));
            const delta = Number(btn.getAttribute('data-delta'));

            if (key === 'possession') {
              const newVal = Math.max(0, Math.min(100, state.stats.possession[side] + delta));
              state.stats.possession[side] = newVal;
              state.stats.possession[1 - side] = 100 - newVal;
            } else {
              state.stats[key][side] = Math.max(0, state.stats[key][side] + delta);
            }
            renderAll();
            broadcastState();
          });
